// js-thread.worker.js
self.onmessage = async function(e) {
    const { code, threadId, sab } = e.data;
    const statusView = new Int32Array(sab, 0, 256);
    const resultView = new Int32Array(sab, 1024, 256);
    
    try {
        self.postMessage({ type: 'debug', msg: 'Worker started. Compiling async function...' });
        
        // Create the async function from the C++ string
        const AsyncFunction = Object.getPrototypeOf(async function(){}).constructor;
        const func = new AsyncFunction(code);
        
        self.postMessage({ type: 'debug', msg: 'Executing async code...' });
        const result = await func();
        
        self.postMessage({ type: 'debug', msg: `Finished! Result: ${result}. Waking up runner...` });
        
        // Write result and wake up the blocked C++ thread
        resultView[threadId] = Number(result) | 0; 
        Atomics.store(statusView, threadId, 1);
        Atomics.notify(statusView, threadId);
    } catch (err) {
        self.postMessage({ type: 'debug', msg: `ERROR: ${err.message}` });
        resultView[threadId] = -1;
        Atomics.store(statusView, threadId, 1);
        Atomics.notify(statusView, threadId);
    }
};